# ── Nani identity / your details ─────────────────────────────────────────────
BOT_NAME=Nani
BOT_TAGLINE=Your thoughtful AI assistant
BOT_OWNER_NAME=Your Name
BOT_OWNER_BIO=Add a short introduction about yourself or your work.
BUSINESS_NAME=
SUPPORT_EMAIL=you@example.com
SUPPORT_PHONE=
BUSINESS_HOURS=Monday–Friday, 9:00 AM–5:00 PM

# ── General-question AI ─────────────────────────────────────────────────────
# Set ONE of these keys in Render. LLM_API_KEY works with OpenAI-compatible
# providers; OPENAI_API_KEY is supported as an alias.
LLM_API_KEY=
# OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.45
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=45

# ── App security / deployment ───────────────────────────────────────────────
# Generate a long random value. This protects /admin, /api/logs, and /api/stats.
ADMIN_TOKEN=replace-with-a-long-random-secret
# Comma-separated origins when embedding Nani on another website. Keep * for
# a standalone Render app, or use your exact HTTPS domain(s).
ALLOWED_ORIGINS=*
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
DB_PATH=data/nani.db
APP_ENV=development
